{
  "semantic": {
    "color": {
      "background": {
        "default":  { "$value": "{color.gray.0}",   "$type": "color" },
        "subtle":   { "$value": "{color.gray.50}",  "$type": "color" },
        "muted":    { "$value": "{color.gray.100}", "$type": "color" }
      },
      "foreground": {
        "default":  { "$value": "{color.gray.900}", "$type": "color" },
        "subtle":   { "$value": "{color.gray.600}", "$type": "color" },
        "muted":    { "$value": "{color.gray.400}", "$type": "color" },
        "inverted": { "$value": "{color.gray.0}",   "$type": "color" }
      },
      "border": {
        "default": { "$value": "{color.gray.200}", "$type": "color" },
        "strong":  { "$value": "{color.gray.400}", "$type": "color" }
      },
      "primary": {
        "default":     { "$value": "{color.primary.600}", "$type": "color" },
        "hover":       { "$value": "{color.primary.700}", "$type": "color" },
        "foreground":  { "$value": "{color.gray.0}",      "$type": "color" }
      },
      "danger": {
        "default":    { "$value": "{color.danger.600}", "$type": "color" },
        "foreground": { "$value": "{color.gray.0}",     "$type": "color" }
      },
      "success": {
        "default":    { "$value": "{color.success.600}", "$type": "color" },
        "foreground": { "$value": "{color.gray.0}",      "$type": "color" }
      },
      "warning": {
        "default":    { "$value": "{color.warning.500}", "$type": "color" },
        "foreground": { "$value": "{color.gray.0}",      "$type": "color" }
      }
    }
  }
}
