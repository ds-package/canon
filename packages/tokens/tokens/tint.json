{
  "tint": {
    "$type": "color",
    "cool": {
      "background": {
        "low": { "$value": "{color.gray.50}" }
      },
      "surface": {
        "default": { "$value": "{color.white}" },
        "raised": { "$value": "{color.white}" },
        "overlay": { "$value": "{color.white}" },
        "tinted": { "$value": "{color.gray.100}" }
      },
      "border": {
        "default": { "$value": "{color.gray.200}" },
        "emphasis": { "$value": "{color.gray.400}" },
        "disabled": { "$value": "{color.gray.100}" }
      },
      "control": {
        "neutral": { "$value": "{color.gray.50}" },
        "disabled": { "$value": "{color.gray.50}" }
      }
    },
    "warm": {
      "background": {
        "low": { "$value": "{color.warm.50}" }
      },
      "surface": {
        "default": { "$value": "{color.warm.50}" },
        "raised": { "$value": "{color.warm.50}" },
        "overlay": { "$value": "{color.warm.50}" },
        "tinted": { "$value": "{color.warm.100}" }
      },
      "border": {
        "default": { "$value": "{color.warm.200}" },
        "emphasis": { "$value": "{color.warm.400}" },
        "disabled": { "$value": "{color.warm.100}" }
      },
      "control": {
        "neutral": { "$value": "{color.warm.100}" },
        "disabled": { "$value": "{color.warm.100}" }
      }
    }
  }
}
