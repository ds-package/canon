{
  "name": "@canon/tokens",
  "version": "1.0.1",
  "description": "Canon Design System tokens: CSS Variables, JS, TypeScript, Tailwind preset",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./css": "./dist/css/variables.css",
    "./tailwind": "./dist/tailwind/preset.js",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tokens/*.json": "./tokens/*.json",
    "./build": "./scripts/build.js"
  },
  "files": [
    "dist/css",
    "dist/tailwind",
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "tokens",
    "scripts/build.js"
  ],
  "scripts": {
    "build": "node scripts/build.js && tsup",
    "dev": "tsup --watch src --watch tokens --watch scripts/build.js",
    "test": "pnpm build && node --test scripts/*.test.js"
  },
  "peerDependencies": {
    "style-dictionary": "^4.1.4"
  },
  "peerDependenciesMeta": {
    "style-dictionary": {
      "optional": true
    }
  },
  "devDependencies": {
    "style-dictionary": "^4.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
