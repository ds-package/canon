{
  "name": "canon",
  "private": true,
  "version": "0.0.0",
  "description": "Canon Design System monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "test": "pnpm build && node --test packages/tokens/scripts/*.test.js packages/tokens/preview/*.test.js docs/tools/figma-plugins/type-styles/*.test.js scripts/*.test.js",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "check": "pnpm test && pnpm typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "esbuild",
      "style-dictionary"
    ]
  }
}
